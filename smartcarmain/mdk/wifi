#define WIFI_APP_AT_LINE_SIZE        (64)
#define WIFI_APP_COMMAND_SIZE        (128)
#define WIFI_APP_TX_SIZE             (220)
#define WIFI_APP_TELEMETRY_MS_MIN    (100)
#define WIFI_APP_TELEMETRY_MS_MAX    (2000)

