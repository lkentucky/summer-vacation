static uint32 wifi_app_last_telemetry_tick = 0;
static char wifi_app_at_line[WIFI_APP_AT_LINE_SIZE];
static uint16 wifi_app_at_line_length = 0;
static uint16 wifi_app_payload_remaining = 0;
static char wifi_app_command[WIFI_APP_COMMAND_SIZE];
static uint16 wifi_app_command_length = 0;

typedef enum
{
